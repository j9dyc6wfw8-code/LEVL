# Standalone EAS build copy.
#
# ios/ IS COMMITTED here on purpose — EAS resolves signing credentials before
# upload, so a plugin-generated widget target is invisible to it unless the
# Xcode project already exists. Do not add ios/ to this file.
#
# Leading slashes are load-bearing: unanchored ios/ also matches modules/*/ios/,
# which holds the native Swift source.

/node_modules/
/ios/Pods/
/ios/build/
/ios/*.xcworkspace/xcuserdata/
/ios/*.xcodeproj/xcuserdata/
/android/
/.expo/
/dist/
.DS_Store
*.log
