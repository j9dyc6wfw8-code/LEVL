{
  "_READ_THIS_FIRST": [
    "iOS CONFIG IN THIS FILE IS NOT APPLIED AT BUILD TIME.",
    "ios/ is committed on purpose (see .easignore: EAS resolves widget signing",
    "credentials before upload, so the Xcode project has to already exist).",
    "Because the native folder exists, EAS Build does NOT sync these keys:",
    "orientation, userInterfaceStyle, scheme, backgroundColor, icon, splash,",
    "ios, android, plugins. `npx expo-doctor` reports this on every run.",
    "",
    "So the blocks below are a MIRROR kept for reference, not configuration.",
    "To actually change iOS behaviour, edit BOTH:",
    "  ios/LEVL/Info.plist          usage strings, orientations, URL schemes",
    "  ios/LEVL.xcodeproj           version, build number, device family",
    "and keep the mirror below in step so the two never disagree.",
    "",
    "Editing only this file changes nothing, and the failure is silent."
  ],
  "expo": {
    "name": "LEVL",
    "slug": "ascend",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "levl",
    "backgroundColor": "#08090f",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matteo.ascend",
      "buildNumber": "29",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "LEVL uses your front and rear cameras to capture your daily Check In — one photo of your training and one of you, taken together.",
        "NSHealthShareUsageDescription": "LEVL shows your daily activity from Apple Health alongside your training. This information is for context only — it never changes your XP, stats or rank, and it is never shared with other people.",
        "NSHealthUpdateUsageDescription": "LEVL can save the workouts you log into Apple Health, so your training appears alongside the rest of your activity.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "app.levl.start-workout",
            "UIApplicationShortcutItemTitle": "Start Workout",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCompose",
            "UIApplicationShortcutItemUserInfo": {
              "url": "levl://train"
            }
          },
          {
            "UIApplicationShortcutItemType": "app.levl.check-in",
            "UIApplicationShortcutItemTitle": "Check In",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCapturePhoto",
            "UIApplicationShortcutItemUserInfo": {
              "url": "levl://check-in"
            }
          },
          {
            "UIApplicationShortcutItemType": "app.levl.active-duel",
            "UIApplicationShortcutItemTitle": "Active Duel",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeTaskCompleted",
            "UIApplicationShortcutItemUserInfo": {
              "url": "levl://compete/duels"
            }
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.matteo.ascend",
      "versionCode": 29,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090f"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LEVL uses your front and rear cameras to capture your daily Check In.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffc933",
          "defaultChannel": "default"
        }
      ],
      "./plugins/withLevlWidgets",
      "./plugins/withResourceBundleSigning"
    ],
    "extra": {
      "supabaseUrl": "https://pndocotsoadxoklqwzys.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBuZG9jb3Rzb2FkeG9rbHF3enlzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM5OTM1NzAsImV4cCI6MjA5OTU2OTU3MH0.VQRNXt2XxJCsXCti59WfqS6DUwEdW4YJ12ZSSpnt5Q4",
      "eas": {
        "projectId": "da32203f-4912-465e-b63a-099a48196f5f"
      }
    }
  }
}
